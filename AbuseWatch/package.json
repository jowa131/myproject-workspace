{
  "name": "abusewatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:migrate": "node scripts/migrate-sqlite.mjs",
    "data:seed:print": "node --experimental-strip-types scripts/print-seed.ts",
    "clusters:demo": "node --experimental-strip-types scripts/clusters-demo.ts",
    "report:export": "node --experimental-strip-types scripts/report-export.ts",
    "scan:guardrails": "node --experimental-strip-types scripts/scan-guardrails.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
