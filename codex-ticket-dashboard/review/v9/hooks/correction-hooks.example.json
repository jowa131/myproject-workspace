{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|compact|clear)$",
        "hooks": [
          {
            "timeout": 2,
            "command": "& 'C:/REPLACE_WITH_PROTECTED_RUNTIME/observe.cmd' 'C:/REPLACE_WITH_PROTECTED_RUNTIME/python.exe' 'C:/REPLACE_WITH_APPROVED_CONFIG/dashboard.toml' 'REPLACE_WITH_HOST_ID' 'unknown'; exit $LASTEXITCODE",
            "commandWindows": "& 'C:/REPLACE_WITH_PROTECTED_RUNTIME/observe.cmd' 'C:/REPLACE_WITH_PROTECTED_RUNTIME/python.exe' 'C:/REPLACE_WITH_APPROVED_CONFIG/dashboard.toml' 'REPLACE_WITH_HOST_ID' 'unknown'; exit $LASTEXITCODE",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "timeout": 5,
            "command": "& 'C:/REPLACE_WITH_PROTECTED_RUNTIME/observe.cmd' 'C:/REPLACE_WITH_PROTECTED_RUNTIME/python.exe' 'C:/REPLACE_WITH_APPROVED_CONFIG/dashboard.toml' 'REPLACE_WITH_HOST_ID' 'unknown'; exit $LASTEXITCODE",
